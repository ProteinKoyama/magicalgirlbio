[sub_resource type="Shader" id="Shader_gingham_background"]
code = "shader_type canvas_item;
render_mode unshaded;

uniform float cell_size : hint_range(24.0, 160.0, 1.0) = 64.0;
uniform vec2 scroll_speed = vec2(14.0, 9.0);
uniform float stripe_strength : hint_range(0.0, 0.3, 0.01) = 0.09;

void fragment() {
	vec4 base_color = COLOR;
	vec2 moving_pixel = FRAGCOORD.xy + TIME * scroll_speed;
	vec2 checker = mod(floor(moving_pixel / cell_size), 2.0);
	float vertical_stripe = checker.x;
	float horizontal_stripe = checker.y;
	float gingham_shade = (vertical_stripe + horizontal_stripe) * stripe_strength;
	vec3 pattern_color = base_color.rgb * (1.0 - gingham_shade);
	COLOR = vec4(pattern_color, base_color.a);
}"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_gingham_background"]
shader = SubResource("Shader_gingham_background")
shader_parameter/cell_size = 64.0
shader_parameter/scroll_speed = Vector2(14, 9)
shader_parameter/stripe_strength = 0.09

