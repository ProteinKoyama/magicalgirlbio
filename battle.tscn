[sub_resource type="Shader" id="Shader_enemy_defeat"]
code = "shader_type canvas_item;

uniform float shake_offset = 0.0;
uniform float disappear_progress : hint_range(0.0, 1.0) = 0.0;

void vertex() {
	VERTEX.x += shake_offset;
}

void fragment() {
	float visible_area = 1.0 - step(1.0 - disappear_progress, UV.y);
	COLOR.a *= visible_area;
}"

